# Copy to ~/.vivarium/.env to work everywhere, or to .env here for this clone
# alone. Both are loaded and the repository's wins for a run made inside it.
# This file carries names only -- never a key, not even a truncated one.
#
#     cp .env.example ~/.vivarium/.env      # every project
#     cp .env.example .env                  # this clone only
#
# bin/vivarium loads both itself, so no run depends on you having sourced
# anything. Keys do NOT go in ~/.vivarium/config: that file is meant to be
# copied into projects and committed, and this one is not.
# Any single provider below is enough; vivarium uses the first one configured
# and offers the rest by name (`--model deepseek`). Endpoint and model lines are
# optional -- the default shown in the comment is used when they are unset.

# DeepSeek -- the provider this repository's own experiments were run against.
DEEPSEEK_API_KEY=
# DEEPSEEK_ENDPOINT=https://api.deepseek.com/v1/chat/completions
# DEEPSEEK_MODEL=deepseek-v4-flash

# OpenAI.
OPENAI_API_KEY=
# OPENAI_ENDPOINT=https://api.openai.com/v1/chat/completions
# OPENAI_MODEL=gpt-4.1-mini

# OpenRouter -- OpenAI-compatible, many models behind one key.
OPENROUTER_API_KEY=
# OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
# OPENROUTER_MODEL=openai/gpt-oss-120b

# Amazon Bedrock through its OpenAI-compatible endpoint: a bearer token, not
# SigV4, so nothing here signs requests.
BEDROCK_API_KEY=
# BEDROCK_ENDPOINT=https://bedrock-mantle.us-east-1.api.aws/v1/chat/completions
# BEDROCK_MODEL=google.gemma-4-31b

# A local llama.cpp server. No key: setting the endpoint is what offers it, and
# it is dropped from the list when nothing answers there.
# VIVARIUM_LOCAL_ENDPOINT=http://localhost:8080/v1/chat/completions
# VIVARIUM_LOCAL_MODEL=gpt-oss-20b

# How much context the model will accept, when the default 128000 is wrong.
# Too low costs one summary nobody needed; too high fails the request that
# compaction existed to prevent.
# VIVARIUM_CONTEXT_LIMIT=128000
