(defvar *flags* '(:metrics))
(defun flag-on (f) (and (member f *flags*) t))
(defstruct tool name)
(defvar *registry* '())
(defun register (tool) (push tool *registry*) tool)
(register (make-tool :name "read"))
(when (flag-on :metrics) (register (make-tool :name "metrics")))
(when (flag-on :trace) (register (make-tool :name "trace")))
(defun tool-names (tools) (mapcar #'tool-name tools))
(defun make-agent () *registry*)
