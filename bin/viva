#!/bin/sh
# One entry point for every run. It sources no key file: credentials live in
# ~/.viva/auth.json and the engine reads them itself, so no run depends on this
# script having exported anything -- which a standalone build never could.
set -eu

# Follow symlinks to find the REPOSITORY, not the link. `viva install`
# puts a link on your PATH, so $0 is usually somewhere like ~/.local/bin --
# and resolving the root from there looked for the repository beside the link
# and died on a missing bin/entry.lisp. Found by installing and then running
# the command from an unrelated directory, which is the only place it shows.
#
# A loop rather than `readlink -f`: that flag is GNU, and this has to work on
# the BSD readlink macOS ships. Relative link targets resolve against the
# directory of the link that carried them.
target=$0
while [ -L "$target" ]; do
  link=$(readlink "$target")
  case $link in
    /*) target=$link ;;
    *)  target=$(dirname "$target")/$link ;;
  esac
done

root=$(cd "$(dirname "$target")/.." && pwd)

# Where viva keeps its own files. The engine resolves it the same way.
viva_home="${VIVA_HOME:-${HOME:-}/.viva}"

# NO KEY FILE IS SOURCED HERE. Credentials live in ~/.viva/auth.json, read by
# the engine itself, so a run does not depend on the launcher having exported
# anything -- which is what a standalone build never had. A shell that exports
# a key still wins: the engine puts the environment above the file.
#
# The full-screen client is a separate binary, and this is where it is reached
# -- BEFORE sbcl, not from inside it. Routing to it from the Lisp CLI worked
# and cost the whole system load first: a minute of quickload to hand the
# terminal to a program that starts in milliseconds. The launcher already knows
# the root and the environment, which is all that was needed.
#
# It falls through to the Lisp client when the Rust one has not been built,
# because a checkout with no cargo must still have a full-screen client.
# BARE `viva` IS THE FULL-SCREEN CLIENT, when there is a terminal to draw
# on. Typing the name of the thing should open the thing; `viva tui` asks a
# person to know which of two clients they want before they have seen either.
#
# Only when stdout is a terminal. Piped or redirected, `viva` stays the
# line client it has always been -- that is the form that scripts and diffs,
# and a full-screen program in a pipe is a program drawing into a buffer
# nobody reads.
if [ $# -eq 0 ] && [ -t 1 ] && [ -t 0 ]; then
  set -- tui
fi

case "${1:-}" in
  tui|live)
    for candidate in \
      "$root/tui/target/release/viva-tui" \
      "$root/tui/target/debug/viva-tui"
    do
      if [ -x "$candidate" ]; then
        shift
        # ONLY IF NOBODY SAID OTHERWISE. The client starts a daemon with
        # $VIVA_BIN, so clobbering it here forced every cold start through this
        # script -- one source load for the command and another for the daemon
        # it spawns, about 2.9s of the 3.1s a cold start cost. A guess must
        # never beat an instruction, which is already the rule for VIVA_TUI.
        VIVA_BIN="${VIVA_BIN:-$root/bin/viva}" exec "$candidate" "$@"
      fi
    done
    if [ "${1:-}" = "tui" ]; then
      printf 'The Rust client is not built here, so this is the Lisp one.\n' >&2
      printf 'Build the other with:  sh %s/tui/install.sh\n\n' "$root" >&2
      set -- live "${@:2}"
    fi
    ;;
esac

exec sbcl --script "$root/bin/entry.lisp" "$@"
