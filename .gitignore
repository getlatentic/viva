*.fasl
*.core
*.log
.DS_Store
.env
.env.*
# The one .env file that is meant to be committed: names, no values. Without
# this line the pattern above swallows it, and the exemption has to sit here
# rather than beside it because a later ignore cannot be undone by an earlier
# negation.
!.env.example
system-index.txt
__pycache__/
*.pyc

# The parity fixtures' instruction files ARE the experiment: both harnesses are
# given the same AGENTS.md and nothing else. A global ignore of that name would
# make the comparison quietly unreproducible for anyone who cloned this.
!experiments/parity/fixtures/**/AGENTS.md
tmp/

# Reference harnesses, cloned for comparison and never vendored. Read-only
# study material: how Pi streams bash output, what Codex does with long-running
# commands, how opencode and DeepSeek Harness structure their tools. Cloning
# them beats reasoning from memory about somebody else's design, and committing
# them would mean carrying four other projects' licences and history.
#   third-party/refresh.sh re-clones them.
third-party/

# Generated family data and results: the generator and the receipts are the
# source, and a regenerated family is byte-identical from its seed.
experiments/families/results/
experiments/families/__pycache__/
